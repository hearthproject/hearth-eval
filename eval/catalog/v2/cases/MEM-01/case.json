{
  "schemaVersion": 2,
  "id": "MEM-01",
  "version": 1,
  "title": "写作偏好召回",
  "family": "memory",
  "difficulty": "normal",
  "runModes": [
    "offline"
  ],
  "description": "从长期记忆召回用户写作偏好，并应用到邮件草稿。",
  "goal": "读取 input.json 的记忆与当前任务，生成 result.json。preferences 至少两条，覆盖中文、先结论后细节、不使用表情符号；appliedTo 为 email；每条偏好带 source 与 confidence。",
  "tags": [
    "preference",
    "recall",
    "email"
  ],
  "timeoutMs": 180000,
  "inputs": [
    {
      "kind": "file",
      "label": "任务输入",
      "path": "input.json"
    }
  ],
  "expectedOutputs": [
    "result.json"
  ],
  "graders": [
    {
      "id": "exists",
      "title": "产出 result.json",
      "config": {
        "kind": "file",
        "path": "result.json",
        "minBytes": 40
      }
    },
    {
      "id": "substance",
      "title": "关键结论完整且正确",
      "config": {
        "kind": "json",
        "path": "result.json",
        "requiredPaths": [
          "preferences",
          "appliedTo",
          "notes"
        ],
        "equals": {
          "appliedTo": "email"
        },
        "minArrayLength": {
          "preferences": 3
        }
      }
    },
    {
      "id": "trajectory_gate",
      "title": "执行轨迹预算与错误门禁",
      "config": {
        "kind": "trace",
        "maxSteps": 12,
        "maxToolCalls": 8,
        "maxDurationMs": 120000,
        "requireNoErrors": true
      }
    }
  ],
  "criteria": [
    {
      "id": "exists",
      "label": "产出 result.json",
      "source": "deterministic",
      "points": 20,
      "severity": "blocker",
      "metric": "task_success",
      "graderId": "exists"
    },
    {
      "id": "substance",
      "label": "关键结论完整且正确",
      "source": "deterministic",
      "points": 40,
      "severity": "scored",
      "metric": "knowledge_grounding",
      "graderId": "substance"
    },
    {
      "id": "trajectory_gate",
      "label": "执行轨迹预算与错误门禁",
      "source": "deterministic",
      "points": 0,
      "severity": "blocker",
      "layer": "trajectory",
      "metric": "tool_selection",
      "graderId": "trajectory_gate"
    },
    {
      "id": "judge",
      "label": "方案质量",
      "source": "judge",
      "points": 30,
      "severity": "scored",
      "rubric": "召回的偏好与当前邮件任务相关，来源与置信度完整；无关偏好没有被强行应用。"
    },
    {
      "id": "human",
      "label": "人工抽样复核",
      "source": "human",
      "points": 10,
      "severity": "scored"
    }
  ],
  "budgets": {
    "maxSteps": 12,
    "maxToolCalls": 8,
    "maxDurationMs": 120000
  },
  "humanReview": {
    "prompt": "核对偏好召回与任务相关性。",
    "sampleRate": 0.1
  }
}
