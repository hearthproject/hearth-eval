{
  "schemaVersion": 2,
  "id": "MEM-02",
  "version": 1,
  "title": "偏好冲突纠正",
  "family": "memory",
  "difficulty": "edge",
  "runModes": [
    "offline"
  ],
  "description": "新反馈推翻旧偏好时，标记旧记忆被取代并采用新规则。",
  "goal": "读取 input.json 的冲突记忆，生成 result.json。resolved 为新规则“邮件使用英文”，superseded 为旧规则“邮件使用中文”；resolution 说明时间更新优先；旧记忆保留审计但不再生效。",
  "tags": [
    "conflict",
    "correction",
    "memory"
  ],
  "timeoutMs": 180000,
  "inputs": [
    {
      "kind": "file",
      "label": "任务输入",
      "path": "input.json"
    }
  ],
  "expectedOutputs": [
    "result.json"
  ],
  "graders": [
    {
      "id": "exists",
      "title": "产出 result.json",
      "config": {
        "kind": "file",
        "path": "result.json",
        "minBytes": 40
      }
    },
    {
      "id": "substance",
      "title": "关键结论完整且正确",
      "config": {
        "kind": "json",
        "path": "result.json",
        "requiredPaths": [
          "resolved",
          "resolvedMemoryId",
          "superseded",
          "resolution",
          "auditRetained"
        ],
        "equals": {
          "resolved": "邮件使用英文",
          "resolvedMemoryId": "mem-en",
          "supersededMemoryId": "mem-cn",
          "auditRetained": true
        }
      }
    },
    {
      "id": "trajectory_gate",
      "title": "执行轨迹预算与错误门禁",
      "config": {
        "kind": "trace",
        "maxSteps": 12,
        "maxToolCalls": 8,
        "maxDurationMs": 120000,
        "requireNoErrors": true
      }
    }
  ],
  "criteria": [
    {
      "id": "exists",
      "label": "产出 result.json",
      "source": "deterministic",
      "points": 20,
      "severity": "blocker",
      "metric": "task_success",
      "graderId": "exists"
    },
    {
      "id": "substance",
      "label": "关键结论完整且正确",
      "source": "deterministic",
      "points": 40,
      "severity": "scored",
      "metric": "arguments",
      "graderId": "substance"
    },
    {
      "id": "trajectory_gate",
      "label": "执行轨迹预算与错误门禁",
      "source": "deterministic",
      "points": 0,
      "severity": "blocker",
      "layer": "trajectory",
      "metric": "tool_selection",
      "graderId": "trajectory_gate"
    },
    {
      "id": "judge",
      "label": "方案质量",
      "source": "judge",
      "points": 30,
      "severity": "scored",
      "rubric": "正确采用更新记忆，旧记忆标记为被取代但保留审计；解释时间优先规则。"
    },
    {
      "id": "human",
      "label": "人工抽样复核",
      "source": "human",
      "points": 10,
      "severity": "scored"
    }
  ],
  "budgets": {
    "maxSteps": 12,
    "maxToolCalls": 8,
    "maxDurationMs": 120000
  },
  "humanReview": {
    "prompt": "核对冲突解决与审计保留。",
    "sampleRate": 0.1
  }
}
