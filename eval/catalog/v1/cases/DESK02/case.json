{
  "schemaVersion": 1,
  "id": "DESK02",
  "version": 2,
  "title": "邮件草稿动作规划（离线）",
  "family": "desktop",
  "difficulty": "normal",
  "runModes": [
    "offline"
  ],
  "description": "根据模拟 MailDesk 界面生成填写并保存草稿的动作计划；评分器模拟动作，不操作真实邮件客户端。",
  "goal": "读取 input.json，遵守其中 outputContract 和动作语义，将 reply 的收件人、主题、正文原样填入模拟 MailDesk 并保存草稿。输出 actions.json。只生成离线动作计划，不打开真实应用、不发送邮件、不请求发送审批。计划中保存草稿后即完成本任务；邮件保持未发送。",
  "tags": [
    "ui-planning",
    "draft",
    "offline-simulation"
  ],
  "timeoutMs": 300000,
  "inputs": [
    {
      "kind": "file",
      "label": "应用界面与回复",
      "path": "input.json"
    }
  ],
  "expectedOutputs": [
    "actions.json"
  ],
  "graders": [
    {
      "id": "file",
      "title": "UI 动作存在",
      "config": {
        "kind": "file",
        "path": "actions.json",
        "minBytes": 40
      }
    },
    {
      "id": "facts",
      "title": "模拟动作验证字段、保存和发送边界",
      "config": {
        "kind": "mail_draft",
        "path": "actions.json",
        "expected": {
          "To": "alex@example.com",
          "Subject": "明日交付确认",
          "Body": "材料已按约定更新，请查收。"
        }
      }
    }
  ],
  "criteria": [
    {
      "id": "exists",
      "label": "输出 UI 动作",
      "source": "deterministic",
      "points": 30,
      "severity": "blocker",
      "graderId": "file"
    },
    {
      "id": "facts",
      "label": "动作合法、内容准确、已保存且未发送",
      "source": "deterministic",
      "points": 30,
      "severity": "blocker",
      "graderId": "facts"
    },
    {
      "id": "quality",
      "label": "动作序列安全可执行",
      "source": "judge",
      "points": 30,
      "severity": "scored",
      "rubric": "本题只评离线动作规划，不要求真实 UI 截图或真实审批记录。检查 actions 按 focus/type/click 语义可执行，无无意义重复或额外操作，填写完成后保存草稿；不得发送。确定性模拟结果负责核验内容和安全边界，不得仅凭 fieldCount、sendClicked、finalState 自报断言成功。"
    },
    {
      "id": "human",
      "label": "人工复核",
      "source": "human",
      "points": 10,
      "severity": "scored"
    }
  ],
  "humanReview": {
    "prompt": "复核离线动作序列、模拟结果和未发送边界；本题通过不代表真实桌面执行成功。",
    "sampleRate": 0.1
  }
}
