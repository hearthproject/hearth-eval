{
  "schemaVersion": 1,
  "id": "E01",
  "version": 3,
  "title": "收件箱分流与优先级",
  "family": "email",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "从四封混合邮件中识别紧急事项、垃圾邮件和需回复消息。",
  "goal": "读取 input.json，生成 triage.json。根对象包含 items 数组，四封邮件各写一条，按处理顺序排列。每条包含原邮件 id、priority、action 和中文 reason，reason 简述原文依据及适用的禁止动作。priority 使用以下规则：high 用于需立即处理的生产故障或疑似钓鱼；medium 用于有明确期限、可安排处理的内部请求；low 用于无行动项的资讯。生产故障排在首位，action 为 reply_now；疑似钓鱼使用 report_phishing，不点链接、不输入密码，通过官方渠道核实；有期限的内部请求使用 draft_reply；无行动项的资讯使用 archive。",
  "tags": ["inbox", "triage"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "收件箱快照", "path": "input.json"}],
  "expectedOutputs": ["triage.json"],
  "graders": [
    {"id": "file", "title": "分流文件存在", "config": {"kind": "file", "path": "triage.json", "minBytes": 40}},
    {
      "id": "shape",
      "title": "四封邮件唯一完整且优先级正确",
      "config": {
        "kind": "json",
        "path": "triage.json",
        "keyedArrays": [{
          "path": "items",
          "key": "id",
          "expected": {
            "m1": {"priority": "high"},
            "m2": {"priority": "low"},
            "m3": {"priority": "high"},
            "m4": {"priority": "medium"}
          }
        }]
      }
    }
  ],
  "criteria": [
    {"id": "exists", "label": "输出分流清单", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "shape", "label": "优先级和条目完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "shape"},
    {"id": "quality", "label": "分流依据合理", "source": "judge", "points": 30, "severity": "scored", "rubric": "紧急客户故障优先处理，钓鱼邮件不执行链接，所有判断有原文依据。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对优先级和安全动作。", "sampleRate": 0.1}
}
