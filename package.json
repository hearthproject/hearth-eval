{
  "name": "hearth-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearth 独立评测 Agent：任务集、实验编排、评分复核与可视化控制台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n eval-server,eval-web -c magenta,cyan \"npm run dev -w @hearth/eval-server\" \"npm run dev -w @hearth/eval-web\"",
    "dev:server": "npm run dev -w @hearth/eval-server",
    "dev:web": "npm run dev -w @hearth/eval-web",
    "build": "npm run build -w @hearth/eval-web",
    "start": "npm run start -w @hearth/eval-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scenarios": "tsc -p scenario-runner/tsconfig.json --noEmit",
    "eval:scenarios": "tsx --tsconfig scenario-runner/tsconfig.json scenario-runner/run-scenarios.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "mermaid": "^11.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=22.13"
  }
}
