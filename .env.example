# Evaluation service
HEARTH_EVAL_HOST=127.0.0.1
HEARTH_EVAL_PORT=4318
HEARTH_URL=http://127.0.0.1:4317

# Evaluator-owned data
HEARTH_EVAL_DATA_DIR=.hearth/eval
HEARTH_EVAL_ARTIFACT_ROOT=.hearth/eval-artifacts
HEARTH_EVAL_CASES_DIR=eval/cases

# Absolute path shared with the Hearth server. Hearth only accepts input
# files below this directory through POST /api/eval/tasks.
HEARTH_EVAL_INPUT_ROOT=D:\App\hearth-eval\eval
